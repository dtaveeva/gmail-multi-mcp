{
  "name": "gmail-multi-mcp",
  "version": "0.1.0",
  "description": "MCP server for multiple Gmail accounts. Per-account permission tiers, two-phase confirmation on every send, and prompt-injection defenses on untrusted mail content.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gmail",
    "email",
    "claude",
    "multi-account",
    "llm-tools"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "bin": {
    "gmail-multi-mcp": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@googleapis/gmail": "^18.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "google-auth-library": "10.5.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
